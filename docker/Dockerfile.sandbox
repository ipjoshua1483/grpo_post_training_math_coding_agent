FROM python:3.12-slim
# Record the built image ID in every run; pin the base digest on the GPU host.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements/sandbox.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt
COPY src/tool_rl/worker.py /opt/worker.py
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python", "-I", "/opt/worker.py"]

